<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.safe-server-opsd</string>

    <key>UserName</key>
    <string>sshops</string>

    <key>GroupName</key>
    <string>opsclients</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/venv/safe-server-ops/bin/opsd</string>
        <string>--servers-env</string>
        <string>/var/lib/sshops/.ssh-servers.env</string>
        <string>--policy</string>
        <string>/var/lib/sshops/policy.yaml</string>
        <string>--socket</string>
        <string>/var/run/sshops/ops.sock</string>
        <string>--admin-socket</string>
        <string>/var/run/sshops/admin.sock</string>
        <string>--audit-log</string>
        <string>/var/log/sshops/audit.jsonl</string>
        <string>--socket-group</string>
        <string>opsclients</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>/var/log/sshops/opsd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/sshops/opsd.stderr.log</string>
</dict>
</plist>
