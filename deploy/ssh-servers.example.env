# SSH server profiles: literal values, NEVER shell code.
# Compatible with ~/.local/config/ssh_login/.ssh-servers.env
# Copy to /var/lib/sshops/.ssh-servers.env and chmod 600 (owned by sshops)

[prod-web-1]
HOST=203.0.113.10
USER=ai-ops
PORT=22
KEY_FILE=/var/lib/sshops/.ssh/id_ed25519_ai_ops
SYNC_KEY_FILE=/var/lib/sshops/.ssh/id_ed25519_ai_rrsync
